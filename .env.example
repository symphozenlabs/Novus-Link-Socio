# All optional. Without a project id the site serves the built-in brochure content
# and the enquiry form asks visitors to call instead.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Only needed if the dataset is private.
SANITY_API_READ_TOKEN=

# Editor token: lets the enquiry form save submissions as "Enquiry" documents.
SANITY_API_WRITE_TOKEN=
